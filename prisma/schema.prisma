generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model CandidateProfile {
  id String @id @default(cuid())

  userId String @unique @default("")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String

  email String?
  phone String?

  location String?
  headline String?
  summary  String?

  website  String?
  linkedin String?
  github   String?

  experiences Experience[]
  educations  Education[]
  skills      Skill[]
  projects    Project[]
  targetRoles String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id        String @id @default(cuid())
  profileId String

  company  String
  title    String
  location String?

  startDate DateTime
  endDate   DateTime?
  current   Boolean   @default(false)

  description String?
  bullets     String[]

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Education {
  id        String @id @default(cuid())
  profileId String

  school String
  degree String
  field  String?

  startDate DateTime?
  endDate   DateTime?

  description String?

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        String @id @default(cuid())
  profileId String

  name     String
  category String?
  level    Int?

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, name])
}

model Project {
  id        String @id @default(cuid())
  profileId String

  name         String
  description  String?
  technologies String[]

  url       String?
  githubUrl String?

  startDate DateTime?
  endDate   DateTime?

  profile CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id String @id @default(cuid())

  userId String @default("")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source     String
  externalId String

  title       String
  company     String?
  description String?

  location   String?
  department String?

  contractType String?
  experience   String?
  salary       String?

  url String?

  sourceCreatedAt DateTime?
  sourceUpdatedAt DateTime?

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analysis          JobAnalysis?
  resumes           Resume[]
  coverLetters      CoverLetter[]
  applications      Application[]
  applicationMethod ApplicationMethod @default(UNKNOWN)
  applicationStatus ApplicationStatus @default(DRAFT)
  applicationUrl    String?
  contactEmail      String?

  @@unique([userId, source, externalId], name: "source_externalId")
  @@index([userId])
  @@index([source])
  @@index([title])
}

model JobAnalysis {
  id String @id @default(cuid())

  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  requiredSkills String[]
  optionalSkills String[]
  technologies   String[]

  seniority     String?
  remote        String?
  salarySummary String?

  matchedSkills String[]
  missingSkills String[]

  score Int?

  summary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resume {
  id String @id @default(cuid())

  userId String @default("")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  title String

  summary String?

  skills String[]

  content Json?

  status String @default("DRAFT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverLetters CoverLetter[]
  applications Application[]

  @@index([jobId])
  @@index([userId])
}

model CoverLetter {
  id String @id @default(cuid())

  userId String @default("")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  title   String
  content String

  status String @default("DRAFT")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]

  @@index([jobId])
  @@index([resumeId])
  @@index([userId])
}

enum ApplicationStatus {
  DRAFT
  READY_TO_VALIDATE
  APPROVED
  SENDING
  SENT
  FAILED
  RESPONSE_RECEIVED
  INTERVIEW
  REJECTED
  FOLLOW_UP
  ARCHIVED
}

enum ApplicationMethod {
  UNKNOWN
  EMAIL
  FRANCE_TRAVAIL
  PARTNER
  EXTERNAL_SITE
  MANUAL
}

model Application {
  id String @id @default(cuid())

  userId String @default("")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String
  job   Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  resumeId String?
  resume   Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  coverLetterId String?
  coverLetter   CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)

  status ApplicationStatus @default(DRAFT)

  channel String?
  notes String?

  appliedAt DateTime?
  followUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId])
  @@index([status])
  @@index([userId])
}


model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  firstName String?
  lastName  String?

  emailVerifiedAt     DateTime?
  verifyTokenHash     String?   @unique
  verifyTokenExpires  DateTime?

  // Administration : USER ou ADMIN (le propriétaire).
  role         String    @default("USER")
  // Autorisations accordées par l'administrateur (phase de test).
  canCollect   Boolean   @default(false)
  canSendEmail Boolean   @default(false)
  // Réservé à la version premium : jetons consommables.
  credits      Int       @default(0)
  disabledAt   DateTime?

  sessions     Session[]
  profile      CandidateProfile?
  jobs         Job[]
  resumes      Resume[]
  coverLetters CoverLetter[]
  applications Application[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
